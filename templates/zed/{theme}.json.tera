{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "{{ theme.name }}",
  "author": "cappyzawa",
  "themes": [{% for v in variants %}
    {
      "name": "{{ theme.name }} {{ v.variant.name }}",
      "appearance": "{{ v.variant.appearance }}",
      "style": {
        "border": "{{ v.roles.ui.border }}",
        "border.variant": "{{ v.roles.ui.border }}",
        "border.focused": "{{ v.roles.ui.accent }}",
        "border.selected": "{{ v.roles.ui.accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ v.roles.ui.border }}80",
        "elevated_surface.background": "{{ v.roles.ui.raised }}",
        "surface.background": "{{ v.roles.ui.inset }}",
        "background": "{{ v.base.background }}",
        "element.background": "{{ v.roles.ui.inset }}",
        "element.hover": "{{ v.roles.ui.border }}80",
        "element.active": "{{ v.roles.ui.border }}",
        "element.selected": "{{ v.roles.ui.border }}",
        "element.disabled": "{{ v.roles.ui.inset }}",
        "drop_target.background": "{{ v.roles.ui.accent }}40",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ v.roles.ui.border }}50",
        "ghost_element.active": "{{ v.roles.ui.border }}",
        "ghost_element.selected": "{{ v.roles.ui.border }}",
        "ghost_element.disabled": "{{ v.roles.ui.inset }}",
        "text": "{{ v.base.foreground }}",
        "text.muted": "{{ v.roles.ui.muted }}",
        "text.placeholder": "{{ v.roles.ui.muted }}",
        "text.disabled": "{{ v.roles.ui.muted }}",
        "text.accent": "{{ v.roles.ui.accent }}",
        "icon": "{{ v.base.foreground }}",
        "icon.muted": "{{ v.roles.ui.muted }}",
        "icon.disabled": "{{ v.roles.ui.muted }}",
        "icon.placeholder": "{{ v.roles.ui.muted }}",
        "icon.accent": "{{ v.roles.ui.accent }}",
        "status_bar.background": "{{ v.roles.ui.inset }}",
        "title_bar.background": "{{ v.roles.ui.inset }}",
        "title_bar.inactive_background": "{{ v.roles.ui.inset }}",
        "toolbar.background": "{{ v.base.background }}",
        "tab_bar.background": "{{ v.roles.ui.inset }}",
        "tab.inactive_background": "{{ v.roles.ui.inset }}",
        "tab.active_background": "{{ v.base.background }}",
        "search.match_background": "{{ v.roles.ui.match_bg }}",
        "panel.background": "{{ v.roles.ui.inset }}",
        "panel.focused_border": "{{ v.roles.ui.accent }}",
        "panel.indent_guide": "{{ v.roles.ui.border }}",
        "panel.indent_guide_hover": "{{ v.roles.ui.muted }}",
        "panel.indent_guide_active": "{{ v.roles.ui.accent }}",
        "pane.focused_border": "{{ v.roles.ui.accent }}",
        "pane_group.border": "{{ v.roles.ui.border }}",
        "scrollbar.thumb.background": "{{ v.roles.ui.border }}80",
        "scrollbar.thumb.hover_background": "{{ v.roles.ui.border }}",
        "scrollbar.thumb.border": "{{ v.roles.ui.border }}00",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{ v.roles.ui.border }}00",
        "editor.foreground": "{{ v.base.foreground }}",
        "editor.background": "{{ v.base.background }}",
        "editor.gutter.background": "{{ v.base.background }}",
        "editor.subheader.background": "{{ v.roles.ui.inset }}",
        "editor.active_line.background": "{{ v.roles.ui.sunken }}",
        "editor.highlighted_line.background": "{{ v.roles.ui.sunken }}",
        "editor.line_number": "{{ v.roles.ui.border }}",
        "editor.active_line_number": "{{ v.roles.ui.accent }}",
        "editor.invisible": "{{ v.roles.ui.border }}",
        "editor.wrap_guide": "{{ v.roles.ui.border }}",
        "editor.active_wrap_guide": "{{ v.roles.ui.muted }}",
        "editor.document_highlight.read_background": "{{ v.roles.ui.border }}80",
        "editor.document_highlight.write_background": "{{ v.roles.ui.border }}",
        "editor.indent_guide": "{{ v.roles.ui.border }}",
        "editor.indent_guide_active": "{{ v.roles.ui.muted }}",
        "terminal.background": "{{ v.base.background }}",
        "terminal.foreground": "{{ v.base.foreground }}",
        "terminal.bright_foreground": "{{ v.ansi.bright.white }}",
        "terminal.dim_foreground": "{{ v.roles.ui.muted }}",
        "terminal.ansi.black": "{{ v.ansi.black }}",
        "terminal.ansi.red": "{{ v.ansi.red }}",
        "terminal.ansi.green": "{{ v.ansi.green }}",
        "terminal.ansi.yellow": "{{ v.ansi.yellow }}",
        "terminal.ansi.blue": "{{ v.ansi.blue }}",
        "terminal.ansi.magenta": "{{ v.ansi.magenta }}",
        "terminal.ansi.cyan": "{{ v.ansi.cyan }}",
        "terminal.ansi.white": "{{ v.ansi.white }}",
        "terminal.ansi.bright_black": "{{ v.ansi.bright.black }}",
        "terminal.ansi.bright_red": "{{ v.ansi.bright.red }}",
        "terminal.ansi.bright_green": "{{ v.ansi.bright.green }}",
        "terminal.ansi.bright_yellow": "{{ v.ansi.bright.yellow }}",
        "terminal.ansi.bright_blue": "{{ v.ansi.bright.blue }}",
        "terminal.ansi.bright_magenta": "{{ v.ansi.bright.magenta }}",
        "terminal.ansi.bright_cyan": "{{ v.ansi.bright.cyan }}",
        "terminal.ansi.bright_white": "{{ v.ansi.bright.white }}",
        "link_text.hover": "{{ v.roles.ui.link }}",
        "conflict": "{{ v.roles.diff.conflict }}",
        "conflict.background": "{{ v.roles.diff.conflict }}20",
        "conflict.border": "{{ v.roles.diff.conflict }}",
        "created": "{{ v.roles.diff.added }}",
        "created.background": "{{ v.roles.diff.added }}20",
        "created.border": "{{ v.roles.diff.added }}",
        "deleted": "{{ v.roles.diff.removed }}",
        "deleted.background": "{{ v.roles.diff.removed }}20",
        "deleted.border": "{{ v.roles.diff.removed }}",
        "error": "{{ v.roles.diagnostic.error }}",
        "error.background": "{{ v.roles.diagnostic.error }}20",
        "error.border": "{{ v.roles.diagnostic.error }}",
        "hidden": "{{ v.roles.ui.muted }}",
        "hidden.background": "{{ v.roles.ui.inset }}",
        "hidden.border": "{{ v.roles.ui.border }}",
        "hint": "{{ v.roles.diagnostic.hint }}",
        "hint.background": "{{ v.roles.diagnostic.hint }}20",
        "hint.border": "{{ v.roles.diagnostic.hint }}",
        "ignored": "{{ v.roles.ui.muted }}",
        "ignored.background": "{{ v.roles.ui.inset }}",
        "ignored.border": "{{ v.roles.ui.border }}",
        "info": "{{ v.roles.diagnostic.info }}",
        "info.background": "{{ v.roles.diagnostic.info }}20",
        "info.border": "{{ v.roles.diagnostic.info }}",
        "modified": "{{ v.roles.diff.changed }}",
        "modified.background": "{{ v.roles.diff.changed }}20",
        "modified.border": "{{ v.roles.diff.changed }}",
        "predictive": "{{ v.roles.ui.muted }}",
        "predictive.background": "{{ v.roles.diagnostic.hint }}20",
        "predictive.border": "{{ v.roles.diagnostic.hint }}",
        "renamed": "{{ v.ansi.bright.cyan }}",
        "renamed.background": "{{ v.ansi.bright.cyan }}20",
        "renamed.border": "{{ v.ansi.bright.cyan }}",
        "success": "{{ v.roles.diagnostic.success }}",
        "success.background": "{{ v.roles.diagnostic.success }}20",
        "success.border": "{{ v.roles.diagnostic.success }}",
        "unreachable": "{{ v.roles.ui.muted }}",
        "unreachable.background": "{{ v.roles.ui.inset }}",
        "unreachable.border": "{{ v.roles.ui.border }}",
        "warning": "{{ v.roles.diagnostic.warning }}",
        "warning.background": "{{ v.roles.diagnostic.warning }}20",
        "warning.border": "{{ v.roles.diagnostic.warning }}",
        "players": [{% for c in v.roles.series %}
          {
            "cursor": "{{ c }}",
            "background": "{{ c }}",
            "selection": "{% if loop.first %}{{ v.roles.ui.selection_bg }}{% else %}{{ c }}40{% endif %}"
          }{% if not loop.last %},{% endif %}{% endfor %}
        ],
        "syntax": {
          "attribute": { "color": "{{ v.roles.syntax.attribute }}" },
          "boolean": { "color": "{{ v.roles.syntax.constant }}" },
          "comment": { "color": "{{ v.roles.syntax.comment }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ v.roles.syntax.comment }}", "font_style": "italic" },
          "constant": { "color": "{{ v.roles.syntax.constant }}" },
          "constructor": { "color": "{{ v.roles.syntax.type }}" },
          "embedded": { "color": "{{ v.roles.syntax.punctuation_special }}" },
          "emphasis": { "color": "{{ v.roles.syntax.text }}", "font_style": "italic" },
          "emphasis.strong": { "color": "{{ v.roles.ui.accent }}", "font_weight": 700 },
          "enum": { "color": "{{ v.roles.syntax.type }}" },
          "function": { "color": "{{ v.roles.syntax.function }}" },
          "function.builtin": { "color": "{{ v.ansi.bright.yellow }}" },
          "hint": { "color": "{{ v.roles.ui.muted }}", "font_style": "italic" },
          "keyword": { "color": "{{ v.roles.syntax.keyword }}" },
          "label": { "color": "{{ v.roles.syntax.label }}" },
          "link_text": { "color": "{{ v.ansi.cyan }}" },
          "link_uri": { "color": "{{ v.roles.ui.link }}", "font_style": "italic" },
          "number": { "color": "{{ v.roles.syntax.number }}" },
          "operator": { "color": "{{ v.roles.syntax.text }}" },
          "predictive": { "color": "{{ v.roles.ui.muted }}", "font_style": "italic" },
          "preproc": { "color": "{{ v.roles.syntax.macro }}" },
          "primary": { "color": "{{ v.roles.syntax.text }}" },
          "property": { "color": "{{ v.roles.syntax.member }}" },
          "punctuation": { "color": "{{ v.roles.syntax.text }}" },
          "punctuation.bracket": { "color": "{{ v.roles.syntax.text }}" },
          "punctuation.delimiter": { "color": "{{ v.roles.syntax.text }}" },
          "punctuation.list_marker": { "color": "{{ v.ansi.cyan }}" },
          "punctuation.special": { "color": "{{ v.roles.syntax.punctuation_special }}" },
          "string": { "color": "{{ v.roles.syntax.string }}" },
          "string.escape": { "color": "{{ v.roles.syntax.escape }}" },
          "string.regex": { "color": "{{ v.roles.syntax.regexp }}" },
          "string.special": { "color": "{{ v.roles.syntax.string }}" },
          "string.special.symbol": { "color": "{{ v.roles.syntax.builtin }}" },
          "tag": { "color": "{{ v.roles.syntax.tag }}" },
          "text.literal": { "color": "{{ v.roles.markup.raw }}" },
          "title": { "color": "{{ v.roles.markup.heading_1 }}", "font_weight": 700 },
          "type": { "color": "{{ v.roles.syntax.type }}" },
          "type.builtin": { "color": "{{ v.roles.syntax.type }}" },
          "variable": { "color": "{{ v.roles.syntax.variable }}" },
          "variable.special": { "color": "{{ v.roles.syntax.builtin }}", "font_style": "italic" },
          "variant": { "color": "{{ v.roles.syntax.constant }}" }
        }
      }
    }{% if not loop.last %},{% endif %}{% endfor %}
  ]
}
