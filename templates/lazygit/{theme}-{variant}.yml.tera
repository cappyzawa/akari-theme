# {{ theme.name }} {{ variant.name }} theme for Lazygit
# {{ variant.description }}
#
# To use this theme, set the LG_CONFIG_FILE environment variable:
#   export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/themes/{{ theme.id }}-{{ variant.id }}.yml"

gui:
  theme:
    activeBorderColor:
      - "{{ roles.ui.accent }}"
      - bold
    inactiveBorderColor:
      - "{{ roles.ui.border }}"
    searchingActiveBorderColor:
      - "{{ roles.ui.accent_secondary }}"
      - bold
    optionsTextColor:
      - "{{ roles.diagnostic.info }}"
    selectedLineBgColor:
      - "{{ roles.ui.selection_bg }}"
    inactiveViewSelectedLineBgColor:
      - "{{ roles.ui.sunken }}"
    cherryPickedCommitFgColor:
      - "{{ roles.ui.accent }}"
    cherryPickedCommitBgColor:
      - "{{ roles.ui.surface }}"
    markedBaseCommitFgColor:
      - "{{ roles.ui.on_accent }}"
    markedBaseCommitBgColor:
      - "{{ roles.ui.accent_secondary }}"
    unstagedChangesColor:
      - "{{ roles.diff.changed }}"
    defaultFgColor:
      - "{{ base.foreground }}"

  authorColors:
    "*": "{{ roles.series.0 }}"
