{%- set id = theme.id | upper -%}
{%- set first = variants.0.variant.id -%}
# {{ theme.name }} zsh-syntax-highlighting theme - zsh plugin entry point
# Loads the appropriate theme based on {{ id }}_VARIANT environment variable.

: ${{ "{" }}{{ id }}_VARIANT:={{ first }}{{ "}" }}

{% if variants | length == 1 -%}
source "${0:A:h}/{{ theme.id }}-{{ first }}.zsh"
{% else -%}
if [[ "${{ id }}_VARIANT" == "{{ variants.1.variant.id }}" ]]; then
  source "${0:A:h}/{{ theme.id }}-{{ variants.1.variant.id }}.zsh"
{% for v in variants | slice(start=2) -%}
elif [[ "${{ id }}_VARIANT" == "{{ v.variant.id }}" ]]; then
  source "${0:A:h}/{{ theme.id }}-{{ v.variant.id }}.zsh"
{% endfor -%}
else
  source "${0:A:h}/{{ theme.id }}-{{ first }}.zsh"
fi
{% endif -%}
