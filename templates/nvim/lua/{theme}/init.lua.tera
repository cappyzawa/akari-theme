-- {{ theme.name }} colorscheme for Neovim
-- {{ theme.description }}

local M = {}

M.config = {
  undercurl = true,
  commentStyle = { italic = true },
  functionStyle = {},
  keywordStyle = {},
  transparent = false,
  terminalColors = true,
  variant = "{{ variants.0.variant.id }}", -- {% for v in variants %}"{{ v.variant.id }}"{% if not loop.last %} or {% endif %}{% endfor %}
}

function M.setup(opts)
  M.config = vim.tbl_deep_extend("force", M.config, opts or {})
end

function M.load(variant)
  local palette_module = require("{{ theme.id }}.palette")

  -- Allow variant to be passed directly or use config; fall back to the
  -- palette's default variant when the requested id is unknown.
  local selected_variant = variant or M.config.variant
  if not palette_module.variants[selected_variant] then
    selected_variant = palette_module.default
  end

  -- Setting 'background' reloads the scheme named by g:colors_name, so it
  -- runs before the highlights below rather than after them.
  vim.o.background = palette_module.appearance[selected_variant]

  if vim.g.colors_name then
    vim.cmd("hi clear")
  end

  vim.g.colors_name = "{{ theme.id }}"
  vim.o.termguicolors = true

  if vim.fn.exists("syntax_on") then
    vim.cmd("syntax reset")
  end

  local highlights = require("{{ theme.id }}.highlights")

  local palette = palette_module.variants[selected_variant]
  local terminal = palette_module.get_terminal(selected_variant)

  local hl = highlights.setup(palette, M.config)

  if M.config.terminalColors then
    highlights.apply(hl, terminal)
  else
    highlights.apply(hl, {})
  end
end

return M
