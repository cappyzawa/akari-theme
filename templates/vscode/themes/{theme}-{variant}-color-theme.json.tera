{
  "name": "{{ theme.name }} {{ variant.name }}",
  "type": "{{ variant.appearance }}",
  "colors": {
    "focusBorder": "{{ roles.ui.accent }}",
    "foreground": "{{ base.foreground }}",
    "disabledForeground": "{{ roles.ui.muted }}",
    "errorForeground": "{{ roles.diagnostic.error }}",
    "descriptionForeground": "{{ roles.ui.muted }}",
    "icon.foreground": "{{ base.foreground }}",

    "activityBar.background": "{{ roles.ui.inset }}",
    "activityBar.foreground": "{{ base.foreground }}",
    "activityBar.inactiveForeground": "{{ roles.ui.muted }}",
    "activityBar.border": "{{ roles.ui.border }}",
    "activityBar.activeBorder": "{{ roles.ui.accent }}",
    "activityBarBadge.background": "{{ roles.ui.accent }}",
    "activityBarBadge.foreground": "{{ base.background }}",

    "sideBar.background": "{{ roles.ui.inset }}",
    "sideBar.foreground": "{{ base.foreground }}",
    "sideBar.border": "{{ roles.ui.border }}",
    "sideBarTitle.foreground": "{{ base.foreground }}",
    "sideBarSectionHeader.background": "{{ roles.ui.inset }}",
    "sideBarSectionHeader.foreground": "{{ base.foreground }}",
    "sideBarSectionHeader.border": "{{ roles.ui.border }}",

    "editor.background": "{{ base.background }}",
    "editor.foreground": "{{ base.foreground }}",
    "editorCursor.foreground": "{{ roles.ui.cursor }}",
    "editor.selectionBackground": "{{ roles.ui.selection_bg }}",
    "editor.selectionForeground": "{{ roles.ui.selection_fg }}",
    "editor.inactiveSelectionBackground": "{{ roles.ui.border }}80",
    "editor.selectionHighlightBackground": "{{ roles.ui.border }}80",
    "editor.wordHighlightBackground": "{{ roles.ui.border }}80",
    "editor.wordHighlightStrongBackground": "{{ roles.ui.border }}80",
    "editor.findMatchBackground": "{{ roles.ui.match_bg }}",
    "editor.findMatchHighlightBackground": "{{ roles.ui.match_bg }}80",
    "editor.lineHighlightBackground": "{{ roles.ui.sunken }}",
    "editor.lineHighlightBorder": "{{ roles.ui.sunken }}00",
    "editorLink.activeForeground": "{{ roles.ui.link }}",

    "editorGutter.background": "{{ base.background }}",
    "editorGutter.modifiedBackground": "{{ roles.diff.changed }}",
    "editorGutter.addedBackground": "{{ roles.diff.added }}",
    "editorGutter.deletedBackground": "{{ roles.diff.removed }}",

    "editorLineNumber.foreground": "{{ roles.ui.border }}",
    "editorLineNumber.activeForeground": "{{ roles.ui.accent }}",

    "editorIndentGuide.background1": "{{ roles.ui.border }}",
    "editorIndentGuide.activeBackground1": "{{ roles.ui.muted }}",

    "editorRuler.foreground": "{{ roles.ui.border }}",

    "editorWhitespace.foreground": "{{ roles.ui.border }}",

    "editorBracketMatch.background": "{{ roles.ui.border }}",
    "editorBracketMatch.border": "{{ roles.ui.accent }}",

    "editorBracketHighlight.foreground1": "{{ roles.series[0] }}",
    "editorBracketHighlight.foreground2": "{{ roles.series[1] }}",
    "editorBracketHighlight.foreground3": "{{ roles.series[2] }}",
    "editorBracketHighlight.foreground4": "{{ roles.series[3] }}",
    "editorBracketHighlight.foreground5": "{{ roles.series[4] }}",
    "editorBracketHighlight.foreground6": "{{ roles.series[5] }}",
    "editorBracketHighlight.unexpectedBracket.foreground": "{{ roles.diagnostic.error }}",

    "editorBracketPairGuide.activeBackground1": "{{ roles.series[0] }}",
    "editorBracketPairGuide.activeBackground2": "{{ roles.series[1] }}",
    "editorBracketPairGuide.activeBackground3": "{{ roles.series[2] }}",
    "editorBracketPairGuide.activeBackground4": "{{ roles.series[3] }}",
    "editorBracketPairGuide.activeBackground5": "{{ roles.series[4] }}",
    "editorBracketPairGuide.activeBackground6": "{{ roles.series[5] }}",

    "editorOverviewRuler.border": "{{ roles.ui.border }}",
    "editorOverviewRuler.errorForeground": "{{ roles.diagnostic.error }}",
    "editorOverviewRuler.warningForeground": "{{ roles.diagnostic.warning }}",
    "editorOverviewRuler.infoForeground": "{{ roles.diagnostic.info }}",

    "editorError.foreground": "{{ roles.diagnostic.error }}",
    "editorWarning.foreground": "{{ roles.diagnostic.warning }}",
    "editorInfo.foreground": "{{ roles.diagnostic.info }}",
    "editorHint.foreground": "{{ roles.ui.muted }}",

    "editorWidget.background": "{{ roles.ui.inset }}",
    "editorWidget.foreground": "{{ base.foreground }}",
    "editorWidget.border": "{{ roles.ui.border }}",
    "editorSuggestWidget.background": "{{ roles.ui.inset }}",
    "editorSuggestWidget.border": "{{ roles.ui.border }}",
    "editorSuggestWidget.foreground": "{{ base.foreground }}",
    "editorSuggestWidget.selectedBackground": "{{ roles.ui.border }}",
    "editorSuggestWidget.highlightForeground": "{{ roles.ui.accent }}",

    "editorHoverWidget.background": "{{ roles.ui.inset }}",
    "editorHoverWidget.border": "{{ roles.ui.border }}",
    "editorHoverWidget.foreground": "{{ base.foreground }}",

    "peekView.border": "{{ roles.ui.accent }}",
    "peekViewEditor.background": "{{ roles.ui.inset }}",
    "peekViewEditor.matchHighlightBackground": "{{ roles.ui.match_bg }}",
    "peekViewResult.background": "{{ roles.ui.inset }}",
    "peekViewResult.fileForeground": "{{ base.foreground }}",
    "peekViewResult.lineForeground": "{{ roles.ui.muted }}",
    "peekViewResult.matchHighlightBackground": "{{ roles.ui.match_bg }}",
    "peekViewResult.selectionBackground": "{{ roles.ui.border }}",
    "peekViewTitle.background": "{{ roles.ui.inset }}",
    "peekViewTitleDescription.foreground": "{{ roles.ui.muted }}",
    "peekViewTitleLabel.foreground": "{{ base.foreground }}",

    "diffEditor.insertedTextBackground": "{{ roles.diff.added }}20",
    "diffEditor.removedTextBackground": "{{ roles.diff.removed }}20",
    "diffEditor.insertedLineBackground": "{{ roles.diff.added }}15",
    "diffEditor.removedLineBackground": "{{ roles.diff.removed }}15",
    "diffEditorGutter.insertedLineBackground": "{{ roles.diff.added }}25",
    "diffEditorGutter.removedLineBackground": "{{ roles.diff.removed }}25",
    "diffEditorOverview.insertedForeground": "{{ roles.diff.added }}40",
    "diffEditorOverview.removedForeground": "{{ roles.diff.removed }}40",
    "diffEditor.diagonalFill": "{{ roles.ui.border }}",
    "diffEditor.unchangedCodeBackground": "{{ roles.ui.surface }}66",

    "merge.currentHeaderBackground": "{{ roles.diff.ours }}40",
    "merge.incomingHeaderBackground": "{{ roles.diff.theirs }}40",

    "tab.activeBackground": "{{ base.background }}",
    "tab.activeForeground": "{{ base.foreground }}",
    "tab.activeBorder": "{{ roles.ui.accent }}",
    "tab.inactiveBackground": "{{ roles.ui.inset }}",
    "tab.inactiveForeground": "{{ roles.ui.muted }}",
    "tab.border": "{{ roles.ui.inset }}",
    "tab.hoverBackground": "{{ roles.ui.border }}",
    "editorGroupHeader.tabsBackground": "{{ roles.ui.inset }}",
    "editorGroupHeader.tabsBorder": "{{ roles.ui.border }}",

    "titleBar.activeBackground": "{{ roles.ui.inset }}",
    "titleBar.activeForeground": "{{ base.foreground }}",
    "titleBar.inactiveBackground": "{{ roles.ui.inset }}",
    "titleBar.inactiveForeground": "{{ roles.ui.muted }}",
    "titleBar.border": "{{ roles.ui.border }}",

    "statusBar.background": "{{ roles.ui.inset }}",
    "statusBar.foreground": "{{ base.foreground }}",
    "statusBar.border": "{{ roles.ui.border }}",
    "statusBar.debuggingBackground": "{{ roles.ui.accent }}",
    "statusBar.debuggingForeground": "{{ base.background }}",
    "statusBar.noFolderBackground": "{{ roles.ui.inset }}",
    "statusBar.noFolderForeground": "{{ base.foreground }}",
    "statusBarItem.activeBackground": "{{ roles.ui.border }}",
    "statusBarItem.hoverBackground": "{{ roles.ui.border }}",
    "statusBarItem.prominentBackground": "{{ roles.ui.accent }}",
    "statusBarItem.prominentForeground": "{{ base.background }}",
    "statusBarItem.prominentHoverBackground": "{{ ansi.bright.yellow }}",
    "statusBarItem.remoteBackground": "{{ roles.diagnostic.info }}",
    "statusBarItem.remoteForeground": "{{ base.foreground }}",
    "statusBarItem.errorBackground": "{{ roles.diagnostic.error }}",
    "statusBarItem.errorForeground": "{{ base.foreground }}",

    "panel.background": "{{ base.background }}",
    "panel.border": "{{ roles.ui.border }}",
    "panelTitle.activeBorder": "{{ roles.ui.accent }}",
    "panelTitle.activeForeground": "{{ base.foreground }}",
    "panelTitle.inactiveForeground": "{{ roles.ui.muted }}",

    "list.activeSelectionBackground": "{{ roles.ui.border }}",
    "list.activeSelectionForeground": "{{ roles.ui.selection_fg }}",
    "list.inactiveSelectionBackground": "{{ roles.ui.border }}80",
    "list.inactiveSelectionForeground": "{{ base.foreground }}",
    "list.hoverBackground": "{{ roles.ui.border }}50",
    "list.hoverForeground": "{{ base.foreground }}",
    "list.focusBackground": "{{ roles.ui.border }}",
    "list.focusForeground": "{{ roles.ui.selection_fg }}",
    "list.highlightForeground": "{{ roles.ui.accent }}",
    "list.errorForeground": "{{ roles.diagnostic.error }}",
    "list.warningForeground": "{{ roles.diagnostic.warning }}",

    "quickInput.background": "{{ roles.ui.inset }}",
    "quickInput.foreground": "{{ base.foreground }}",
    "quickInputList.focusBackground": "{{ roles.ui.border }}",
    "quickInputTitle.background": "{{ roles.ui.inset }}",

    "dropdown.background": "{{ roles.ui.inset }}",
    "dropdown.foreground": "{{ base.foreground }}",
    "dropdown.border": "{{ roles.ui.border }}",
    "dropdown.listBackground": "{{ roles.ui.inset }}",

    "input.background": "{{ roles.ui.inset }}",
    "input.foreground": "{{ base.foreground }}",
    "input.border": "{{ roles.ui.border }}",
    "input.placeholderForeground": "{{ roles.ui.muted }}",
    "inputOption.activeBackground": "{{ roles.ui.border }}",
    "inputOption.activeForeground": "{{ base.foreground }}",
    "inputOption.activeBorder": "{{ roles.ui.accent }}",

    "inputValidation.infoForeground": "{{ base.foreground }}",
    "inputValidation.infoBackground": "{{ roles.diagnostic.info }}40",
    "inputValidation.infoBorder": "{{ roles.diagnostic.info }}",
    "inputValidation.warningForeground": "{{ base.background }}",
    "inputValidation.warningBackground": "{{ roles.diagnostic.warning }}",
    "inputValidation.warningBorder": "{{ roles.diagnostic.warning }}",
    "inputValidation.errorForeground": "{{ base.foreground }}",
    "inputValidation.errorBackground": "{{ roles.diagnostic.error }}80",
    "inputValidation.errorBorder": "{{ roles.diagnostic.error }}",

    "scrollbar.shadow": "#00000050",
    "scrollbarSlider.background": "{{ roles.ui.border }}80",
    "scrollbarSlider.hoverBackground": "{{ roles.ui.border }}",
    "scrollbarSlider.activeBackground": "{{ roles.ui.muted }}",

    "badge.background": "{{ roles.ui.accent }}",
    "badge.foreground": "{{ base.background }}",

    "button.background": "{{ roles.ui.accent }}",
    "button.foreground": "{{ base.background }}",
    "button.hoverBackground": "{{ ansi.bright.yellow }}",
    "button.secondaryBackground": "{{ roles.ui.border }}",
    "button.secondaryForeground": "{{ base.foreground }}",
    "button.secondaryHoverBackground": "{{ roles.ui.muted }}",

    "gitDecoration.addedResourceForeground": "{{ roles.diff.added }}",
    "gitDecoration.modifiedResourceForeground": "{{ roles.diff.changed }}",
    "gitDecoration.deletedResourceForeground": "{{ roles.diff.removed }}",
    "gitDecoration.renamedResourceForeground": "{{ ansi.bright.cyan }}",
    "gitDecoration.untrackedResourceForeground": "{{ ansi.bright.green }}",
    "gitDecoration.ignoredResourceForeground": "{{ roles.ui.muted }}",
    "gitDecoration.conflictingResourceForeground": "{{ roles.diff.conflict }}",
    "gitDecoration.stageModifiedResourceForeground": "{{ roles.diff.changed }}",
    "gitDecoration.stageDeletedResourceForeground": "{{ roles.diff.removed }}",

    "breadcrumb.background": "{{ base.background }}",
    "breadcrumb.foreground": "{{ roles.ui.muted }}",
    "breadcrumb.focusForeground": "{{ base.foreground }}",
    "breadcrumb.activeSelectionForeground": "{{ base.foreground }}",
    "breadcrumbPicker.background": "{{ roles.ui.inset }}",

    "minimap.background": "{{ base.background }}",
    "minimap.selectionHighlight": "{{ roles.ui.border }}",
    "minimap.errorHighlight": "{{ roles.diagnostic.error }}",
    "minimap.warningHighlight": "{{ roles.diagnostic.warning }}",
    "minimap.findMatchHighlight": "{{ roles.ui.match_bg }}",

    "minimapGutter.modifiedBackground": "{{ roles.diff.changed }}",
    "minimapGutter.addedBackground": "{{ roles.diff.added }}",
    "minimapGutter.deletedBackground": "{{ roles.diff.removed }}",

    "terminal.background": "{{ base.background }}",
    "terminal.foreground": "{{ base.foreground }}",
    "terminal.ansiBlack": "{{ ansi.black }}",
    "terminal.ansiRed": "{{ ansi.red }}",
    "terminal.ansiGreen": "{{ ansi.green }}",
    "terminal.ansiYellow": "{{ ansi.yellow }}",
    "terminal.ansiBlue": "{{ ansi.blue }}",
    "terminal.ansiMagenta": "{{ ansi.magenta }}",
    "terminal.ansiCyan": "{{ ansi.cyan }}",
    "terminal.ansiWhite": "{{ ansi.white }}",
    "terminal.ansiBrightBlack": "{{ ansi.bright.black }}",
    "terminal.ansiBrightRed": "{{ ansi.bright.red }}",
    "terminal.ansiBrightGreen": "{{ ansi.bright.green }}",
    "terminal.ansiBrightYellow": "{{ ansi.bright.yellow }}",
    "terminal.ansiBrightBlue": "{{ ansi.bright.blue }}",
    "terminal.ansiBrightMagenta": "{{ ansi.bright.magenta }}",
    "terminal.ansiBrightCyan": "{{ ansi.bright.cyan }}",
    "terminal.ansiBrightWhite": "{{ ansi.bright.white }}",
    "terminalCursor.foreground": "{{ roles.ui.cursor }}",

    "notifications.background": "{{ roles.ui.inset }}",
    "notifications.foreground": "{{ base.foreground }}",
    "notifications.border": "{{ roles.ui.border }}",
    "notificationCenterHeader.background": "{{ roles.ui.inset }}",
    "notificationCenterHeader.foreground": "{{ base.foreground }}",

    "extensionButton.prominentBackground": "{{ roles.ui.accent }}",
    "extensionButton.prominentForeground": "{{ base.background }}",
    "extensionButton.prominentHoverBackground": "{{ ansi.bright.yellow }}",

    "progressBar.background": "{{ roles.ui.accent }}",

    "editorSemanticHighlighting.enabled": true,

    "settings.headerForeground": "{{ base.foreground }}",
    "settings.modifiedItemIndicator": "{{ roles.diff.changed }}",
    "settings.dropdownBackground": "{{ roles.ui.inset }}",
    "settings.dropdownForeground": "{{ base.foreground }}",
    "settings.dropdownBorder": "{{ roles.ui.border }}",
    "settings.checkboxBackground": "{{ roles.ui.inset }}",
    "settings.checkboxForeground": "{{ base.foreground }}",
    "settings.checkboxBorder": "{{ roles.ui.border }}",
    "settings.textInputBackground": "{{ roles.ui.inset }}",
    "settings.textInputForeground": "{{ base.foreground }}",
    "settings.textInputBorder": "{{ roles.ui.border }}",
    "settings.numberInputBackground": "{{ roles.ui.inset }}",
    "settings.numberInputForeground": "{{ base.foreground }}",
    "settings.numberInputBorder": "{{ roles.ui.border }}",

    "welcomePage.background": "{{ base.background }}",
    "welcomePage.tileBackground": "{{ roles.ui.inset }}",
    "welcomePage.tileHoverBackground": "{{ roles.ui.border }}",

    "debugToolBar.background": "{{ roles.ui.inset }}",
    "debugIcon.breakpointForeground": "{{ roles.diagnostic.error }}",
    "debugIcon.breakpointDisabledForeground": "{{ roles.ui.muted }}",
    "debugIcon.startForeground": "{{ roles.diagnostic.success }}",
    "debugIcon.pauseForeground": "{{ roles.ui.accent }}",
    "debugIcon.stopForeground": "{{ roles.diagnostic.error }}",
    "debugIcon.stepOverForeground": "{{ roles.diagnostic.info }}",
    "debugIcon.stepIntoForeground": "{{ roles.diagnostic.info }}",
    "debugIcon.stepOutForeground": "{{ roles.diagnostic.info }}",
    "debugIcon.restartForeground": "{{ roles.diagnostic.success }}",

    "notebook.editorBackground": "{{ base.background }}",
    "notebook.cellEditorBackground": "{{ roles.ui.inset }}",
    "notebook.cellBorderColor": "{{ roles.ui.border }}",
    "notebook.focusedCellBorder": "{{ roles.ui.accent }}",
    "notebook.cellStatusBarItemHoverBackground": "{{ roles.ui.border }}",

    "charts.red": "{{ roles.diagnostic.error }}",
    "charts.blue": "{{ roles.series[1] }}",
    "charts.yellow": "{{ roles.series[5] }}",
    "charts.orange": "{{ roles.series[0] }}",
    "charts.green": "{{ roles.series[4] }}",
    "charts.purple": "{{ roles.series[2] }}",
    "charts.foreground": "{{ base.foreground }}",
    "charts.lines": "{{ roles.ui.border }}",

    "inlineChat.foreground": "{{ base.foreground }}",
    "inlineChatInput.background": "{{ roles.ui.inset }}",
    "inlineChatDiff.inserted": "{{ roles.diff.added }}40",
    "inlineChatDiff.removed": "{{ roles.diff.removed }}40"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "comment.line",
        "comment.block",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.comment }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double",
        "string.quoted.triple",
        "string.template"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.string }}"
      }
    },
    {
      "name": "String Escape",
      "scope": [
        "constant.character.escape",
        "string.escape"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.escape }}"
      }
    },
    {
      "name": "String Regexp",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.regexp }}"
      }
    },
    {
      "name": "Regexp - Group Punctuation",
      "scope": "punctuation.definition.group.regexp",
      "settings": {
        "foreground": "{{ roles.syntax.regexp }}"
      }
    },
    {
      "name": "Regexp - Character Class",
      "scope": "constant.other.character-class.regexp",
      "settings": {
        "foreground": "{{ roles.syntax.regexp }}"
      }
    },
    {
      "name": "Regexp - Character Class Set",
      "scope": [
        "constant.other.character-class.set.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.regexp }}"
      }
    },
    {
      "name": "Regexp - Quantifier",
      "scope": "keyword.operator.quantifier.regexp",
      "settings": {
        "foreground": "{{ roles.syntax.constant }}"
      }
    },
    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "constant.numeric.octal",
        "constant.numeric.binary"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.constant }}"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant",
        "constant.language",
        "constant.language.boolean",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.constant }}"
      }
    },
    {
      "name": "Character",
      "scope": [
        "constant.character"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.character }}"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.conditional",
        "keyword.control.repeat",
        "keyword.control.loop",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.return",
        "keyword.control.exception",
        "keyword.control.try",
        "keyword.control.catch",
        "keyword.control.throw",
        "keyword.other"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.keyword }}"
      }
    },
    {
      "name": "Keyword Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical",
        "keyword.operator.comparison"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.keyword }}"
      }
    },
    {
      "name": "Storage",
      "scope": [
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.keyword }}"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "meta.function-call",
        "support.function",
        "meta.method-call"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.function }}"
      }
    },
    {
      "name": "Function Builtin",
      "scope": [
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "{{ ansi.bright.yellow }}"
      }
    },
    {
      "name": "Function Macro",
      "scope": [
        "entity.name.function.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.macro }}"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.union",
        "entity.name.trait",
        "entity.name.interface",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.type }}"
      }
    },
    {
      "name": "Type Builtin",
      "scope": [
        "support.type.builtin",
        "support.type.primitive"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.type }}"
      }
    },
    {
      "name": "Type Parameter",
      "scope": [
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.type }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "Variable Builtin",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.self",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.builtin }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Property",
      "scope": [
        "variable.other.property",
        "variable.other.member",
        "variable.other.object.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.member }}"
      }
    },
    {
      "name": "Namespace",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.namespace }}"
      }
    },
    {
      "name": "Constructor",
      "scope": [
        "entity.name.function.constructor",
        "meta.function-call.constructor"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.type }}"
      }
    },
    {
      "name": "Label",
      "scope": [
        "entity.name.label"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.label }}"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "entity.other.attribute-name",
        "meta.attribute"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.attribute }}"
      }
    },
    {
      "name": "Decorator",
      "scope": [
        "meta.decorator"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.decorator }}"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "Punctuation Bracket",
      "scope": [
        "punctuation.definition.block",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.array",
        "punctuation.brackets",
        "punctuation.section"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "Punctuation Special",
      "scope": [
        "punctuation.definition.interpolation",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.punctuation_special }}"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.bitwise",
        "keyword.operator.relational",
        "keyword.operator.ternary"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.tag }}"
      }
    },
    {
      "name": "Tag Builtin",
      "scope": [
        "support.tag"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.tag }}"
      }
    },
    {
      "name": "Tag Attribute",
      "scope": [
        "entity.other.attribute-name.html",
        "entity.other.attribute-name.xml"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.attribute }}"
      }
    },
    {
      "name": "Markup Heading",
      "scope": [
        "markup.heading",
        "markup.heading.setext",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "{{ roles.markup.heading_1 }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 1",
      "scope": "markup.heading.1",
      "settings": {
        "foreground": "{{ roles.markup.heading_1 }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 2",
      "scope": "markup.heading.2",
      "settings": {
        "foreground": "{{ ansi.bright.yellow }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 3",
      "scope": "markup.heading.3",
      "settings": {
        "foreground": "{{ roles.markup.heading_3 }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 4",
      "scope": "markup.heading.4",
      "settings": {
        "foreground": "{{ roles.markup.heading_4 }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 5",
      "scope": "markup.heading.5",
      "settings": {
        "foreground": "{{ roles.syntax.comment }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Heading Level 6",
      "scope": "markup.heading.6",
      "settings": {
        "foreground": "{{ roles.diagnostic.info }}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup Italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Strikethrough",
      "scope": "markup.strikethrough",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "Markup Link URL",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "{{ roles.ui.link }}",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Markup Link Text",
      "scope": [
        "string.other.link.title",
        "string.other.link.description"
      ],
      "settings": {
        "foreground": "{{ ansi.cyan }}"
      }
    },
    {
      "name": "Markup List",
      "scope": [
        "markup.list",
        "punctuation.definition.list"
      ],
      "settings": {
        "foreground": "{{ ansi.cyan }}"
      }
    },
    {
      "name": "Markup Quote",
      "scope": "markup.quote",
      "settings": {
        "foreground": "{{ roles.syntax.comment }}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup Raw / Code",
      "scope": [
        "markup.raw",
        "markup.inline.raw",
        "markup.fenced_code",
        "fenced_code.block.language"
      ],
      "settings": {
        "foreground": "{{ roles.markup.raw }}"
      }
    },
    {
      "name": "Diff Inserted",
      "scope": [
        "markup.inserted",
        "meta.diff.header.to-file"
      ],
      "settings": {
        "foreground": "{{ roles.diff.added }}"
      }
    },
    {
      "name": "Diff Deleted",
      "scope": [
        "markup.deleted",
        "meta.diff.header.from-file"
      ],
      "settings": {
        "foreground": "{{ roles.diff.removed }}"
      }
    },
    {
      "name": "Diff Changed",
      "scope": "markup.changed",
      "settings": {
        "foreground": "{{ roles.diff.changed }}"
      }
    },
    {
      "name": "Invalid",
      "scope": "invalid",
      "settings": {
        "foreground": "{{ roles.diagnostic.error }}"
      }
    },
    {
      "name": "Invalid Deprecated",
      "scope": "invalid.deprecated",
      "settings": {
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON Key - Level 0",
      "scope": "source.json meta.structure.dictionary.json support.type.property-name.json",
      "settings": {
        "foreground": "{{ roles.series[0] }}"
      }
    },
    {
      "name": "JSON Key - Level 1",
      "scope": "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
      "settings": {
        "foreground": "{{ roles.series[1] }}"
      }
    },
    {
      "name": "JSON Key - Level 2",
      "scope": "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
      "settings": {
        "foreground": "{{ roles.series[2] }}"
      }
    },
    {
      "name": "JSON Key - Level 3+",
      "scope": "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json",
      "settings": {
        "foreground": "{{ roles.series[3] }}"
      }
    },
    {
      "name": "YAML Key",
      "scope": "entity.name.tag.yaml",
      "settings": {
        "foreground": "{{ roles.syntax.keyword }}"
      }
    },
    {
      "name": "TOML Key",
      "scope": [
        "keyword.key.toml",
        "support.type.property-name.toml"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.keyword }}"
      }
    },
    {
      "name": "TOML Table",
      "scope": [
        "entity.name.section.toml",
        "entity.other.attribute-name.table.toml"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.namespace }}"
      }
    },
    {
      "name": "CSS Property",
      "scope": "support.type.property-name.css",
      "settings": {
        "foreground": "{{ ansi.cyan }}"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.font-name"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "CSS Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.tag }}"
      }
    },
    {
      "name": "CSS Pseudo Selectors",
      "scope": [
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.function }}"
      }
    },
    {
      "name": "SCSS Mixin/Extend Keywords",
      "scope": [
        "keyword.control.at-rule.mixin",
        "keyword.control.at-rule.include",
        "keyword.control.at-rule.extend"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.macro }}"
      }
    },
    {
      "name": "CSS Property Value",
      "scope": "support.constant.property-value.css",
      "settings": {
        "foreground": "{{ roles.syntax.builtin }}"
      }
    },
    {
      "name": "CSS Unit",
      "scope": "keyword.other.unit.css",
      "settings": {
        "foreground": "{{ roles.syntax.builtin }}"
      }
    },
    {
      "name": "Shell Variable",
      "scope": [
        "variable.other.normal.shell",
        "variable.other.special.shell",
        "variable.other.positional.shell"
      ],
      "settings": {
        "foreground": "{{ base.foreground }}"
      }
    },
    {
      "name": "Shell Command",
      "scope": "support.function.builtin.shell",
      "settings": {
        "foreground": "{{ ansi.bright.yellow }}"
      }
    },
    {
      "name": "Template Interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "{{ roles.syntax.punctuation_special }}"
      }
    },
    {
      "name": "Template Keywords",
      "scope": [
        "keyword.blade",
        "keyword.control.twig",
        "entity.name.function.blade"
      ],
      "settings": {
        "foreground": "{{ ansi.cyan }}"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "class": "{{ roles.syntax.type }}",
    "struct": "{{ roles.syntax.type }}",
    "interface": "{{ roles.syntax.type }}",
    "enum": "{{ roles.syntax.type }}",
    "enumMember": "{{ roles.syntax.constant }}",
    "type": "{{ roles.syntax.type }}",
    "typeParameter": {
      "foreground": "{{ roles.syntax.type }}",
      "italic": true
    },
    "typeAlias": "{{ roles.syntax.type }}",
    "function": "{{ roles.syntax.function }}",
    "method": "{{ roles.syntax.function }}",
    "function.defaultLibrary": "{{ ansi.bright.magenta }}",
    "method.defaultLibrary": "{{ ansi.bright.magenta }}",
    "macro": "{{ roles.syntax.macro }}",
    "variable": "{{ base.foreground }}",
    "variable.readonly": "{{ roles.syntax.constant }}",
    "variable.defaultLibrary": {
      "foreground": "{{ roles.syntax.builtin }}",
      "italic": true
    },
    "variable.static": {
      "foreground": "{{ base.foreground }}",
      "italic": true
    },
    "parameter": {
      "foreground": "{{ base.foreground }}",
      "italic": true
    },
    "property": "{{ base.foreground }}",
    "property.readonly": "{{ roles.syntax.constant }}",
    "namespace": "{{ roles.syntax.namespace }}",
    "module": "{{ roles.syntax.namespace }}",
    "decorator": "{{ roles.syntax.decorator }}",
    "annotation": "{{ roles.syntax.decorator }}",
    "event": "{{ roles.syntax.decorator }}",
    "*.deprecated": {
      "strikethrough": true
    },
    "*.abstract": {
      "italic": true
    },
    "*.async": {
      "italic": true
    },
    "*.modification": {},
    "*.documentation": {},
    "*.declaration": {},
    "keyword": "{{ roles.syntax.keyword }}",
    "string": "{{ roles.syntax.string }}",
    "number": "{{ roles.syntax.constant }}",
    "operator": "{{ base.foreground }}",
    "comment": {
      "foreground": "{{ roles.syntax.comment }}",
      "italic": true
    }
  }
}
